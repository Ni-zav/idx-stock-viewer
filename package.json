{
  "name": "idx-stock-viewer",
  "version": "1.0.0",
  "description": "TradingView-like stock data viewer",
  "type": "module",
  "scripts": {
    "start": "concurrently \"node api-server.js\" \"vite\"",
    "dev": "vite",
    "server": "node api-server.js",
    "build": "tsc && vite build",
    "test": "node --test tests/*.test.js",
    "preview": "vite preview",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "lightweight-charts": "^4.1.0",
    "papaparse": "^5.7.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/papaparse": "^5.3.14",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^9.2.1",
    "typescript": "^5.3.0",
    "vite": "^8.0.0",
    "@playwright/test": "^1.56.0"
  },
  "engines": {
    "node": ">=22.23.4 <23 || >=24.22.1 <25"
  }
}
